# Copy to .env.local for local development.

# Where the website reads the engines' published boards.
# Default: modeling/data/published (relative to the repo root).
# MODELROOM_PUBLISHED_DIR=

# Dev-only plan switcher in the footer (Free / Plus / Pro).
# Leave unset or false in production.
ENABLE_TIER_PREVIEW=true

# Optional: sportsbook lines for the Python engines (read by `python -m modelroom nba odds`).
# ODDS_API_KEY=

# Supabase (optional; not needed to run locally).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shopify customer login and subscription sync (not built yet; see docs/auth-architecture.md).
# All server-only.
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_SHOP_ID=
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# SHOPIFY_FLOW_WEBHOOK_SECRET=
# SHOPIFY_PLAN_MAP={"gid://shopify/SellingPlan/123":"plus","gid://shopify/SellingPlan/456":"pro"}
# MODEL_ROOM_SESSION_SECRET=
# APP_URL=https://your-model-room-domain
